# Groq API anahtarını https://console.groq.com adresinden al, bu dosyayı .env olarak kopyala
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss akıl yürütme düzeyi: low, medium ya da high
GROQ_REASONING_EFFORT=low
# Uygulamanın "şu an" kabul ettiği tarih. Araçlar bu tarihten sonraki veriyi görmez.
AS_OF=2015-10-01 00:00:00
# Kılavuz arama yöntemi: hybrid (önerilen), embedding ya da bm25. hybrid/embedding için: pip install -r requirements-embed.txt
MANUAL_SEARCH=hybrid
# API'yi çağırabilecek arayüz adresleri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000
